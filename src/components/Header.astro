---
import { profile } from '../data/profile';
import Text from './Text.astro';
const { resume = false, home = false } = Astro.props;
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="Kaimau Chang home"><span class="monogram">{profile.initials}<span>.</span></span><span class="wordmark-name">KAIMAU CHANG</span></a>
  <nav id="main-navigation" aria-label="Main navigation">
    <a href="/#about" data-section="about"><Text en="About" zh="關於我" /></a><a href="/#experience" data-section="experience"><Text en="Experience" zh="工作經歷" /></a>
    <a href="/#reports" data-section="reports"><Text en="Reports" zh="產業報告" /></a>
    <a class:list={['nav-resume', resume && 'active']} href="/resume/"><Text en="Résumé" zh="履歷" /> <span aria-hidden="true">↗</span></a>
  </nav>
  {home && <div class="header-controls"><button class="language-toggle" id="home-language" type="button" aria-label="Switch homepage to Chinese">中文</button><button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" /></svg></button></div>}
  <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" aria-label="Open navigation"><span></span><span></span></button>
</header>
<script>
  const menu = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const navigation = document.querySelector('#main-navigation');
  function closeMenu() { menu?.setAttribute('aria-expanded', 'false'); menu?.setAttribute('aria-label', 'Open navigation'); navigation?.classList.remove('menu-open'); }
  menu?.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') !== 'true'; menu.setAttribute('aria-expanded', String(open)); menu.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation'); navigation?.classList.toggle('menu-open', open); });
  navigation?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', event => { if(event.key === 'Escape') { if(menu?.getAttribute('aria-expanded') === 'true') { closeMenu(); menu.focus(); } } });
  matchMedia('(min-width: 901px)').addEventListener('change', event => { if(event.matches) closeMenu(); });
</script>
