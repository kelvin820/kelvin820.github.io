---
import { projects } from '../data/projects';
import Text from './Text.astro';
---
<div class="project-showcase">
  {projects.map(project => <a class="project-card" href={project.url} target="_blank" rel="noopener noreferrer">
    <div class="project-preview"><img src={project.preview.src} width={project.preview.width} height={project.preview.height} alt={project.previewAlt} loading="lazy" decoding="async" /></div>
    <div class="project-copy">
      <p class="project-category"><Text en="INTERACTIVE WEB EXPERIENCE" zh="互動網頁作品" /></p>
      <h3><Text en={project.title} zh={project.zhTitle} /></h3>
      <p class="project-description"><Text en={project.description} zh={project.zhDescription} /></p>
      <span class="project-visit"><Text en="Open project" zh="開啟作品" /><span aria-hidden="true">↗</span></span>
      <span class="sr-only"><Text en="Opens in a new tab" zh="在新分頁開啟" /></span>
    </div>
  </a>)}
</div>
<style>
  .project-showcase { display: grid; gap: 24px; margin-top: 40px; }
  .project-card { display: grid; grid-template-columns: 1.15fr 1fr; min-width: 0; border: 1px solid var(--line); background: var(--surface); transition: border-color .2s; }
  .project-card:hover { border-color: var(--ink); }
  .project-preview { display: grid; place-items: center; background: #f3f2eb; padding: 24px; min-width: 0; }
  .project-preview img { display: block; width: 100%; height: auto; }
  .project-copy { display: flex; flex-direction: column; justify-content: center; padding: 40px; min-width: 0; }
  .project-category { font: 11px/1.8 var(--mono); color: var(--accent); letter-spacing: 1px; }
  .project-copy h3 { font: 400 clamp(32px, 3vw, 46px)/1.2 var(--serif); letter-spacing: -.025em; margin: 20px 0; text-wrap: balance; }
  .project-description { font-size: var(--type-body, 17px); line-height: 1.8; color: var(--muted); }
  .project-visit { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 15px; font-weight: 600; }
  @media (max-width: 900px) { .project-copy { padding: 28px; } }
  @media (max-width: 700px) { .project-card { grid-template-columns: minmax(0, 1fr); }.project-preview { padding: 18px; } }
</style>
