---
import { profile } from '../data/profile';
import Text from './Text.astro';
---
<div class="capability-overview" aria-labelledby="capability-heading">
  <div class="capability-heading"><p class="eyebrow"><Text en="CURRENT FOCUS & APPROACH" zh="目前的能力與方法" /></p><h3 id="capability-heading"><Text en="From technology vision to engineering decisions." zh="從技術願景，走向工程判斷。" /></h3></div>
  <div class="capability-grid">
    {profile.focus.map((focus, i) => <article class="capability-card">
      <div class="capability-index"><span>{focus.number}</span><span>{focus.detail}</span></div>
      <h4><Text en={focus.title} zh={profile.focusZh[i].title} /></h4>
      <p><Text en={focus.text} zh={profile.focusZh[i].text} /></p>
      <ul>{focus.points.map((point, j) => <li><Text en={point} zh={profile.focusZh[i].points[j]} /></li>)}</ul>
    </article>)}
  </div>
</div>
<style>
  .capability-overview { grid-column: 1 / -1; min-width: 0; padding-top: 40px; border-top: 1px solid var(--line); }
  .capability-heading h3 { font: 400 clamp(27px, 2.5vw, 36px)/1.3 var(--serif); letter-spacing: -.02em; margin-top: 16px; text-wrap: balance; }
  .capability-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 32px; border: 1px solid var(--line); }
  .capability-card { min-width: 0; padding: 30px; background: var(--surface); border-right: 1px solid var(--line); }
  .capability-card:last-child { border-right: 0; }
  .capability-index { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px; font: 10px/1.8 var(--mono); color: var(--accent); letter-spacing: .6px; }
  .capability-index > span:first-child { font-size: 14px; }
  .capability-card h4 { font: 500 25px/1.3 var(--serif); margin: 24px 0 16px; letter-spacing: -.015em; text-wrap: balance; }
  .capability-card p, .capability-card li { font-size: 16px; line-height: 1.8; color: var(--muted); }
  .capability-card ul { margin: 24px 0 0; padding-left: 18px; }
  .capability-card li + li { margin-top: 10px; }
  @media (max-width: 1100px) { .capability-card { padding: 24px; } }
  @media (max-width: 900px) { .capability-grid { grid-template-columns: minmax(0, 1fr); }.capability-card { border-right: 0; border-bottom: 1px solid var(--line); }.capability-card:last-child { border-bottom: 0; } }
</style>
