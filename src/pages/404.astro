---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
import Header from '../components/Header.astro';
---
<Layout title={`Page not found — ${profile.name}`}><Header /><main id="main" class="archive-page"><p class="eyebrow">404 / PAGE NOT FOUND</p><h1>A different chapter.</h1><p>This page may have belonged to the retired Hexo blog. The original site is available in the legacy archive.</p><a class="button button-dark" href="/">Go to homepage ↗</a><a class="text-link" href="/legacy/">Legacy archive ↗</a></main></Layout>
