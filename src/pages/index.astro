---
// Portfolio architecture adapted from RyanFitzgerald/devportfolio (MIT).
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Experience from '../components/Experience.astro';
import { profile } from '../data/profile';
---
<Layout>
  <Header />
  <main id="main">
    <section class="hero">
      <div class="hero-content">
        <p class="eyebrow"><span class="small-line"></span> TECHNOLOGY · ENGINEERING · PARTNERSHIPS</p>
        <p class="hero-name">Hello, I’m Kaimau.</p>
        <h1>Connecting<br />technology.<br /><span>Creating possibilities.</span></h1>
        <p class="hero-description">{profile.introduction}</p>
        <div class="hero-actions"><a class="button button-dark" href="#experience">Explore my experience <span aria-hidden="true">↓</span></a><a class="text-link" href="/resume/">View résumé <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="orbit-node node-one"></span><span class="orbit-node node-two"></span><span class="orbit-node node-three"></span><div class="art-core">KC<span>THE NEXT CONNECTION</span></div><span class="art-caption">IDEAS → CONNECTIONS → POSSIBILITIES</span></div>
      <div class="hero-bottom"><span><span class="location-dot"></span>{profile.location}</span><span>{profile.position}</span><a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a></div>
    </section>
    <section id="about" class="section about-section">
      <div class="about-heading"><p class="eyebrow">01 / A LITTLE ABOUT ME</p><h2>Curiosity meets<br /><span>engineering.</span></h2></div>
      <div class="about-copy"><p>{profile.about}</p><div class="skills" aria-label="Areas of expertise">{profile.skills.map(skill => <span>{skill}</span>)}</div></div>
    </section>
    <section class="focus-section" aria-label="Areas of focus">{profile.focus.map(item => <article class="focus-item"><span class="focus-number">{item.number}</span><h3>{item.title}</h3><p>{item.text}</p><span class="focus-detail">{item.detail}</span></article>)}</section>
    <Experience />
    <section class="section education-section"><div><p class="eyebrow">03 / EDUCATION</p><h2>An engineering foundation.</h2></div><div class="education-detail"><h3>{profile.education.school}</h3><p>{profile.education.degree}</p><span>{profile.education.start} — {profile.education.end}</span></div></section>
    <section id="contact" class="contact-section"><p class="eyebrow">LET’S CONNECT</p><h2>The next possibility<br />starts with a conversation.</h2><div class="contact-actions"><a class="button button-dark" href={`mailto:${profile.email}`}>Get in touch <span aria-hidden="true">↗</span></a><a class="text-link" href={profile.linkedin} target="_blank" rel="noreferrer">Find me on LinkedIn ↗</a></div></section>
  </main>
  <footer class="site-footer"><span>© {new Date().getFullYear()} {profile.name}</span><div><a href="/resume/">Printable résumé</a><a href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a><a href="/legacy/">Legacy archive</a></div></footer>
</Layout>
